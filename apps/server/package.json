{
  "name": "@crystal/server",
  "version": "1.1.0",
  "private": true,
  "description": "Crystal API server. Also serves the built web app in production.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "swagger-ui-dist": "^5.34.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@crystal/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oauth2-mock-server": "^9.3.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
