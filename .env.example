# ─────────────────────────────────────────────────────────────────────────────
# Crystal configuration. Copy to `.env` and adjust. Every variable is optional;
# empty values use the default. Full reference: docs/configuration.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose ───────────────────────────────────────────────────────────
# Image tag to run (e.g. 1.0.0, 1.0, 1 or latest).
CRYSTAL_VERSION=latest
# Port on the host. Change this one, not PORT, to publish Crystal elsewhere.
CRYSTAL_PORT=3000

# ── Server ───────────────────────────────────────────────────────────────────
# Public URL you open Crystal at, without a path – e.g. https://todo.example.com.
# Required for single sign-on. Cookies are marked Secure automatically when it
# starts with https://. Must match the address in the browser exactly; leave it
# empty to accept whatever host Crystal is opened at (fine for a home network).
BASE_URL=

# Number of reverse proxies in front of Crystal (Traefik, Caddy, Nginx …) whose
# X-Forwarded-* headers are trusted: false, true (= 1) or a number.
TRUST_PROXY=false

# Send Strict-Transport-Security (only over HTTPS). Often set by the proxy instead.
HSTS=false

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Encryption and signing key, at least 32 characters. If empty, a random key is
# generated on first start and stored in the data volume (/data/secret.key).
SECRET_KEY=

# Port and address inside the container. Normally left alone.
# PORT=3000
# HOST=0.0.0.0

# ── Accounts ─────────────────────────────────────────────────────────────────
# Who may create an account after the first one (which always becomes admin):
#   invite – only with an invite link from an administrator (default)
#   open   – anyone who can reach the instance
#   closed – nobody (accounts only via single sign-on, if enabled)
REGISTRATION=invite

# Allow signing in with username/email and password. Can only be turned off
# when single sign-on is configured.
PASSWORD_LOGIN=true

# How long a session stays valid without activity, in days (1–365).
SESSION_TTL_DAYS=30

# ── Single sign-on (OpenID Connect) ──────────────────────────────────────────
# Works with Authentik, Keycloak, Authelia, Pocket ID, Zitadel and others.
# Redirect URI to register at the provider: <BASE_URL>/api/v1/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Text on the sign-in button ("Continue with …").
OIDC_BUTTON_LABEL=SSO
OIDC_SCOPES=openid profile email
# Create an account on the first SSO sign-in (otherwise only linked accounts work).
OIDC_AUTO_REGISTER=true
# Members of this group become administrators (and lose the role when removed).
OIDC_ADMIN_GROUP=
# Name of the claim that lists the user's groups.
OIDC_GROUPS_CLAIM=groups

# ── Notifications ────────────────────────────────────────────────────────────
# Browser notifications (Web Push) need HTTPS but no settings. ntfy, Gotify and
# Apprise are set up by each user under Settings → Notifications.
# How often reminders and daily summaries are checked, in seconds.
REMINDER_INTERVAL_SECONDS=30
# Allow notification services at loopback and private network addresses (e.g.
# ntfy in the same Docker network). Set to false if you do not trust all users.
NOTIFY_PRIVATE_NETWORKS=true

# ── Backups ──────────────────────────────────────────────────────────────────
# Hours between automatic database backups; 0 turns them off.
BACKUP_INTERVAL_HOURS=24
# How many backups to keep.
BACKUP_RETENTION=7
# Where backups go (default: /data/backups). Point it at another disk if you can.
BACKUP_DIR=

# ── Attachments ──────────────────────────────────────────────────────────────
# Largest file (image or PDF) that can be attached to a task, in MiB (1–100).
ATTACHMENT_MAX_MB=10
# Largest map picture of a game (gaming mode), in MiB (1–100).
MAP_MAX_MB=25

# ── Steam (gaming mode) ──────────────────────────────────────────────────────
# Web API key from https://steamcommunity.com/dev/apikey. With it, people on a
# gaming instance can import games with all their achievements.
STEAM_API_KEY=
# Hours between automatic syncs of imported games; 0 syncs only on request.
STEAM_SYNC_HOURS=6

# ── Email ────────────────────────────────────────────────────────────────────
# For email notifications and "Forgot password?" (which also needs BASE_URL).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. Crystal <crystal@example.com>. Required with SMTP_HOST.
SMTP_FROM=
